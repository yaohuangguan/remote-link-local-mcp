# Reference only: Remote Link does not automatically load .env files.
# Set these in the shell that launches Remote Link / tunnel-client.

# Off by default. Enables the generic Desktop Commander proxy tool.
REMOTE_LINK_ALLOW_CORE_CALL=0

# Off by default. When disabled, only the read-oriented allowlist is callable.
REMOTE_LINK_ALLOW_ALL_TOOLS=0

# Optional comma-separated extra upstream tool names.
REMOTE_LINK_ALLOWED_TOOLS=

# Override the local Desktop Commander launcher if needed.
REMOTE_LINK_DESKTOP_COMMANDER_COMMAND=npx
REMOTE_LINK_DESKTOP_COMMANDER_PACKAGE=@wonderwhy-er/desktop-commander@latest
