# Reference only. Remote Arc Local MCP does not automatically load .env files.
# Set these in the shell that launches the MCP server.

# Permission mode: safe | developer | full
# safe: read-only
# developer: read + file editing + Local Undo
# full: developer capabilities + terminal execution protected by Safety Guard
REMOTE_ARC_MODE=safe

# Optional launcher override.
REMOTE_ARC_DESKTOP_COMMANDER_COMMAND=npx
REMOTE_ARC_DESKTOP_COMMANDER_PACKAGE=@wonderwhy-er/desktop-commander

# Legacy REMOTE_LINK_* variable names are still accepted for compatibility.
