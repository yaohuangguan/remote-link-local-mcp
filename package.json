{
  "name": "remote-link-local-mcp",
  "version": "0.2.0",
  "description": "Standalone local MCP execution layer for Remote Arc, backed by Desktop Commander OSS.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector pnpm tsx src/index.ts",
    "test:smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@wonderwhy-er/desktop-commander": "0.2.51",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@wonderwhy-er/desktop-commander",
      "puppeteer",
      "sharp"
    ]
  }
}
