{
  "name": "remote-link",
  "version": "0.1.0",
  "description": "Open, self-hostable bridge between AI clients and a local computer over MCP.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
